{
  "$meta": {
    "name": "TramitaDOC Design Tokens",
    "version": "1.0.0",
    "date": "2026-11-16",
    "source": "Extraído do deck (/apresentacao/) e do vídeo em Remotion (src/ui.tsx)"
  },
  "color": {
    "navy-900": "#071a33",
    "navy-800": "#0b2545",
    "navy-700": "#13315c",
    "blue-600": "#1550b8",
    "blue-500": "#1d63d6",
    "blue-100": "#e6eefb",
    "blue-50": "#f3f7fd",
    "teal-700": "#0b6f65",
    "teal-600": "#0d8a7d",
    "teal-500": "#14b8a6",
    "teal-100": "#d5f5f0",
    "mint-300": "#5eead4",
    "amber-500": "#f59e0b",
    "amber-700": "#b45309",
    "amber-100": "#fef3c7",
    "red-700": "#b42318",
    "red-100": "#fde8e6",
    "violet-600": "#6d4fc2",
    "ink": "#0f1b2d",
    "muted": "#4a5a70",
    "line": "#dbe3ee",
    "bg": "#f5f8fc",
    "card": "#ffffff",
    "white": "#ffffff"
  },
  "semantic": {
    "primary": "{color.navy-800}",
    "primary-strong": "{color.navy-900}",
    "accent": "{color.teal-500}",
    "accent-strong": "{color.teal-600}",
    "link": "{color.blue-500}",
    "success": "{color.teal-600}",
    "warning": "{color.amber-700}",
    "danger": "{color.red-700}",
    "ai": "{color.violet-600}",
    "text": "{color.ink}",
    "text-muted": "{color.muted}",
    "surface": "{color.card}",
    "surface-soft": "{color.bg}",
    "border": "{color.line}"
  },
  "gradient": {
    "brand": "linear-gradient(135deg,#0d8a7d,#14b8a6)",
    "hero-dark": "radial-gradient(1200px 800px at 75% 40%,#174077 0%,#0b2545 48%,#071a33 100%)",
    "text-light": "linear-gradient(90deg,#0d8a7d,#1d63d6)",
    "text-dark": "linear-gradient(90deg,#5eead4,#7cb8ff 60%,#fbbf24)"
  },
  "font": {
    "family": {
      "display": "\"Outfit\",\"Segoe UI\",Roboto,Arial,sans-serif",
      "text": "\"Inter\",\"Segoe UI\",Roboto,Arial,sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "md": "18px",
      "lg": "22px",
      "xl": "28px",
      "2xl": "36px",
      "3xl": "48px",
      "4xl": "64px",
      "5xl": "84px"
    },
    "line-height": {
      "tight": 1.05,
      "snug": 1.2,
      "normal": 1.5
    },
    "letter-spacing": {
      "display": "-0.02em",
      "normal": "0"
    }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "28px",
    "pill": "999px",
    "logo": "14/64 (≈22%)"
  },
  "shadow": {
    "sm": "0 4px 12px rgba(11,37,69,.12)",
    "md": "0 10px 30px -12px rgba(11,37,69,.25)",
    "lg": "0 30px 60px -20px rgba(7,26,51,.45)",
    "glow-teal": "0 20px 50px rgba(20,184,166,.35)"
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "motion": {
    "ease-out": "cubic-bezier(.16,1,.3,1)",
    "ease-in-out": "cubic-bezier(.65,0,.35,1)",
    "duration": {
      "fast": "150ms",
      "base": "300ms",
      "slow": "600ms",
      "enter": "800ms"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "900px",
    "lg": "1200px"
  }
}